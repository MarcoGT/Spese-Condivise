    "onboarding_p1_body" : {
      "comment" : "Onboarding page 1 body",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep track of shared expenses with friends, family or flatmates — always in sync."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni traccia delle spese condivise con amici, familiari o coinquilini — sempre sincronizzato."
          }
        }
      }
    },
    "onboarding_p2_title" : {
      "comment" : "Onboarding page 2 title",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add people, track expenses"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi persone, registra spese"
          }
        }
      }
    },
    "onboarding_p2_body" : {
      "comment" : "Onboarding page 2 body",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create a sheet for each occasion. Add everyone involved and log expenses as you go. The app always shows who owes what."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea un foglio per ogni occasione. Aggiungi tutti i partecipanti e registra le spese man mano. L'app mostra sempre chi deve cosa."
          }
        }
      }
    },
    "onboarding_p3_title" : {
      "comment" : "Onboarding page 3 title",
